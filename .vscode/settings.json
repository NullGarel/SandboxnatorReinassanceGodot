{
  //if the current system is ms windows
  //the one below is the actual active executable path, beware of this if your godotTools extension asks for executable path, i have included this in my settings.json and have chosen to not gitignore it in order to backup for ease of use.
  "linux.editorPath.godot4": "/home/yok939/.local/bin/godot",
  "files.exclude": {
    "**/*.uid": true,
    "**/*.import": true,
    "**/*.remap": true
  },
  "dotnet.enablePackageRestore": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  // Enable code style suggestions
  "csharp.format.enable": true,
  "csharp.suppressDotnetInstallWarning": true,
  // Show code style issues as suggestions
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.fixAll.style": "always"
  }
}