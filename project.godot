; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sandboxnator"
config/description="A LAN multiplayer sandbox game, have fun with your friends, hang out, build and destroy :3"
config/version="0.6.0"
run/main_scene="uid://cghy1wt2we3bu"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/use_filter=false
boot_splash/image="uid://gl3kk4eokacn"
config/icon="res://Assets/Textures/sandboxnator_icon.png"

[autoload]

ApplicationManager="*uid://dsjkf1g1yhl67"
GameRegistriesScene="*uid://dx4fogi4qptr5"
PlayerProfileManager="*res://Source/Entities/Player/Profile/PlayerProfileManager.cs"
UiSoundManager="*res://UI/UiSoundManager.tscn"
ServerDiscovery="*res://Source/Network/ServerDiscovery/ServerDiscovery.tscn"

[display]

window/size/viewport_width=768
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="Sandboxnator Reinassance Godot"

[editor]

run/main_run_args="client"
naming/default_signal_callback_name="_On{node_name}{signal_name}"
naming/default_signal_callback_to_self_name="_On{signal_name}"
naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Export/": "orange",
"res://GameContent/": "yellow",
"res://GameContent/Buildings/": "green",
"res://GameContent/Commands/": "orange",
"res://GameContent/Items/": "teal",
"res://GameContent/Items/_Abstract/": "red",
"res://Source/": "green",
"res://Source/Chat/": "red",
"res://Source/Commands/": "orange",
"res://Source/Common/": "yellow",
"res://Source/Entities/": "green",
"res://Source/Items/": "teal",
"res://Source/Network/": "blue",
"res://Source/Settings/": "purple",
"res://UI/": "blue",
"res://World/": "purple"
}

[gui]

theme/custom="uid://dbnnr7gglht1m"
theme/custom_font="uid://byx34uye6i18w"

